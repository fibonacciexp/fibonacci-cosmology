# Fibonacci Gravitational Dip : Spline C² Continuity
# n=284-289 (JWST z=7-15 tension)

import numpy as np
from scipy.interpolate import CubicSpline
import matplotlib.pyplot as plt

# Fibonacci ticks + mock scale factor (dip)
n_ticks = np.array([284, 285, 286, 287, 288, 289])
a_fib = np.array([0.85, 0.82, 0.79, 0.81, 0.84, 0.87])

# Cubic spline C² (continuité dérivées 1ère/2ème ordre)
cs = CubicSpline(n_ticks, a_fib)

# Plot publication-ready
n_plot = np.linspace(284, 289, 100)
plt.figure(figsize=(8,4))
plt.plot(n_ticks, a_fib, 'o', label='Fibonacci ticks', markersize=8)
plt.plot(n_plot, cs(n_plot), '-', linewidth=2, label='C² spline')
plt.xlabel('Cosmic tick n', fontsize=12)
plt.ylabel('Scale factor a_n', fontsize=12)
plt.title('Fibonacci Gravitational Dip n=284-289', fontsize=14)
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('fibonacci_spline_demo.png', dpi=300)
plt.show()
